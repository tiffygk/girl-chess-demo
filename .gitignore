# nested agent worktrees (owner reorg 2026-07-28) — registered via git worktree,
# never committed as directories into the parent repo. vite.config.ts already
# ignores dev-server watching with the wt-* pattern (union finding 7,
# 2026-07-29); .gitignore now matches instead of hardcoding each worktree
# name, so any future wt-* is ignored automatically.
/girl-chess-eval3/
/girl-chess-r2/
/wt-*/

# vite dep-optimizer cache, recreated on every dev start (2026-07-29)
.vite/

# local env files — never commit credentials (pre-publication audit 2026-08-26)
.env
.env.*
*.env

# local safety backup taken before the 2026-08-26 history rewrite; delete when satisfied
backup-*.git/

# push-guard patterns: read at push time, never committed. Keeping the strings
# out of the tracked tree is the whole point; a guard that spells out what it
# guards against reintroduces the leak in its own body (2026-08-26).
.claude/hooks/.push-guard-patterns
